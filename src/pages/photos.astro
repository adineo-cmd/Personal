---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageNav from '../components/PageNavigation.astro';
import { photosData } from '../data/photos.js';
---

<BaseLayout title="Photos | Aditya Yadav" description="A visual journey through the years">
  <>
    <PageNav currentPage="photos" />

    <div class="min-h-screen bg-[#08080a] text-[#ddd6cc] font-sans">
      <div class="max-w-[1100px] mx-auto px-9 pb-25 relative z-10">
        
        {/* Header Section */}
        <header class="pt-20 pb-13 border-b border-[#2a2a2e]">
          <div class="flex items-center gap-2.5 mb-5">
            <span class="font-mono text-[10px] tracking-[0.3em] uppercase text-[#e0aa40]">Visual Diary</span>
            <div class="w-15 h-px bg-[#e0aa40] opacity-40"></div>
          </div>
          
          <h1 class="font-serif text-[clamp(72px,11vw,130px)] font-black leading-[0.87] tracking-[-0.03em] text-white mb-4.5">
            Pho<span class="text-[#e0aa40] italic">tos</span>
          </h1>
          
          <p class="font-mono text-[10px] text-[#6a6260] tracking-[0.12em] mb-2">
            Updated — {photosData.lastUpdated}
          </p>
          
          <p class="text-[15px] text-[#a89e92] max-w-[540px] leading-[1.7] font-light mb-10">
            {photosData.description}
          </p>

          {/* Stats Grid */}
          <div class="grid grid-cols-4 border border-[#2a2a2e]">
            <div class="p-4.5 border-r border-[#2a2a2e] hover:bg-[#121214] transition-colors">
              <span class="font-serif text-3xl font-bold block mb-1 text-[#e0aa40]">{photosData.stats.totalPhotos}</span>
              <span class="font-mono text-[9px] tracking-[0.18em] uppercase text-[#6a6260]">Photos</span>
            </div>
            <div class="p-4.5 border-r border-[#2a2a2e] hover:bg-[#121214] transition-colors">
              <span class="font-serif text-3xl font-bold block mb-1 text-[#5a9870]">{photosData.stats.activeYears}</span>
              <span class="font-mono text-[9px] tracking-[0.18em] uppercase text-[#6a6260]">Active Years</span>
            </div>
            <div class="p-4.5 border-r border-[#2a2a2e] hover:bg-[#121214] transition-colors">
              <span class="font-serif text-3xl font-bold block mb-1 text-[#d86848]">{photosData.stats.categories}</span>
              <span class="font-mono text-[9px] tracking-[0.18em] uppercase text-[#6a6260]">Categories</span>
            </div>
            <div class="p-4.5 hover:bg-[#121214] transition-colors">
              <span class="font-serif text-3xl font-bold block mb-1 text-[#5a80a8]">{photosData.stats.cameras}</span>
              <span class="font-mono text-[9px] tracking-[0.18em] uppercase text-[#6a6260]">Camera</span>
            </div>
          </div>
        </header>

        {/* Film Strip Decoration */}
        <div class="flex gap-0.5 mt-9 overflow-hidden h-12 bg-[#121214] border border-[#2a2a2e] px-3 items-center">
          <div class="w-3.5 h-5 rounded-sm bg-[#2a2a2e] flex-shrink-0"></div>
          <div class="w-3.5 h-5 rounded-sm bg-[#2a2a2e] flex-shrink-0"></div>
          <span class="font-mono text-[9px] text-[#6a6260] tracking-[0.15em] px-3 whitespace-nowrap">ROLL 001</span>
          {photosData.filmRoll.map((frame) => (
            <div class="flex-1 h-8 bg-gradient-to-br from-[#3a3836] to-[#2a2a2e] border border-[#1e1e22] font-mono text-[7px] text-[#6a6260] flex items-center justify-center tracking-[0.08em]">
              {frame}
            </div>
          ))}
          <span class="font-mono text-[9px] text-[#6a6260] tracking-[0.15em] px-3 whitespace-nowrap">REALME 13 5G</span>
          <div class="w-3.5 h-5 rounded-sm bg-[#2a2a2e] flex-shrink-0"></div>
          <div class="w-3.5 h-5 rounded-sm bg-[#2a2a2e] flex-shrink-0"></div>
        </div>

        {/* Equipment Timeline */}
        <div class="mt-13">
          <div class="flex items-center gap-3.5 pb-3.5 border-b border-[#2a2a2e] mb-5">
            <span>📷</span>
            <h2 class="font-serif text-[22px] font-bold text-white tracking-[-0.01em]">Equipment Timeline</h2>
            <div class="flex-1 h-px bg-gradient-to-r from-[#2a2a2e] to-transparent"></div>
          </div>
          
          <div class="flex gap-0 overflow-x-auto pb-2">
            {photosData.equipment.map((item, index) => (
              <div key={index} class="bg-[#121214] border border-[#1e1e22] p-4 min-w-[160px] relative hover:bg-[#161618] hover:border-[#2a2a2e] transition-all cursor-default flex-shrink-0">
                <div class="absolute top-0 left-0 right-0 h-0.5 bg-[#e0aa40]"></div>
                {index < photosData.equipment.length - 1 && (
                  <span class="absolute right-[-12px] top-1/2 -translate-y-1/2 text-[#3a3836] text-[12px]">→</span>
                )}
                <div class="font-mono text-[10px] text-[#e0aa40] tracking-[0.12em] mb-1.5">{item.period}</div>
                <div class="font-serif text-base font-bold text-white mb-1">{item.gear}</div>
                <div class="text-[11px] text-[#6a6260] italic">{item.type}</div>
              </div>
            ))}
          </div>
        </div>

        {/* Toolbar */}
        <div class="flex items-center gap-2 flex-wrap mt-12">
          <div class="flex-1 min-w-[200px] relative">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-[#6a6260] text-[15px] pointer-events-none">⌕</span>
            <input 
              type="text" 
              id="searchInput"
              placeholder="Search photos, tags, descriptions…"
              class="w-full py-2.5 pl-9.5 pr-3.5 bg-[#121214] border border-[#2a2a2e] text-[#ddd6cc] font-sans text-[13px] outline-none focus:border-[#e0aa40] transition-colors placeholder:text-[#6a6260]"
            />
          </div>
          <div class="flex gap-px">
            <button 
              id="btnGrid"
              class="view-btn font-mono text-[10px] tracking-[0.1em] uppercase py-2.5 px-3.5 border border-[#2a2a2e] bg-transparent text-[#6a6260] cursor-pointer hover:text-[#ddd6cc] transition-colors"
              data-view="grid"
            >
              ⊞ Grid
            </button>
            <button 
              id="btnStrip"
              class="view-btn font-mono text-[10px] tracking-[0.1em] uppercase py-2.5 px-3.5 border border-[#2a2a2e] bg-transparent text-[#6a6260] cursor-pointer hover:text-[#ddd6cc] transition-colors"
              data-view="list"
            >
              ≡ List
            </button>
          </div>
        </div>

        {/* Year Filters */}
        <div class="flex gap-1.5 flex-wrap mt-2.5">
          <button 
            class="year-filter active font-mono text-[10px] tracking-[0.1em] py-1.5 px-3.5 border border-[#2a2a2e] bg-transparent text-[#6a6260] cursor-pointer hover:text-[#ddd6cc] transition-colors"
            data-year="all"
          >
            All Years
          </button>
          {photosData.years.map((year) => (
            <button 
              class="year-filter font-mono text-[10px] tracking-[0.1em] py-1.5 px-3.5 border border-[#2a2a2e] bg-transparent text-[#6a6260] cursor-pointer hover:text-[#ddd6cc] transition-colors"
              data-year={year.year}
            >
              {year.year}
            </button>
          ))}
        </div>

        {/* Category Tags */}
        <div class="flex gap-1.5 flex-wrap mt-2.5" id="categoryTags">
          {photosData.categories.map((cat) => (
            <button 
              class="category-tag font-mono text-[10px] tracking-[0.08em] py-1 px-3 border border-[#2a2a2e] text-[#6a6260] cursor-pointer hover:border-[#d86848] hover:text-[#d86848] hover:bg-[#d86848]/[0.07] transition-colors"
              data-category={cat}
            >
              {cat}
            </button>
          ))}
        </div>

        {/* Photo Sections */}
        <div id="photoSections"></div>

        {/* Footer */}
        <footer class="mt-20 pt-6 border-t border-[#2a2a2e] font-mono text-[10px] tracking-[0.1em] text-[#6a6260] flex justify-between">
          <a href="/" class="hover:text-[#a89e92] transition-colors">← back to home</a>
          <span>~/photos · visual diary</span>
        </footer>
      </div>
    </div>

    <style>
      @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@300;400&display=swap');
      
      .font-serif { font-family: 'Playfair Display', serif; }
      .font-sans { font-family: 'DM Sans', sans-serif; }
      .font-mono { font-family: 'DM Mono', monospace; }
      
      .year-filter.active,
      .category-tag.active,
      .view-btn.active {
        border-color: #e0aa40 !important;
        color: #e0aa40 !important;
        background: rgba(224, 170, 64, 0.07) !important;
      }
      
      .photo-card {
        animation: fadeInUp 0.6s forwards;
        opacity: 0;
      }
      
      @keyframes fadeInUp {
        from {
          opacity: 0;
          transform: translateY(16px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      
      .pc-placeholder {
        background: linear-gradient(135deg, #0e0e10, #1e1e22);
        position: relative;
        overflow: hidden;
      }
      
      .pc-placeholder::before {
        content: '';
        position: absolute;
        inset: 0;
        background: repeating-linear-gradient(
          -45deg,
          transparent,
          transparent 12px,
          rgba(255,255,255,0.015) 12px,
          rgba(255,255,255,0.015) 13px
        );
      }
      
      .pc-overlay {
        opacity: 0;
        transition: opacity 0.3s;
      }
      
      .photo-card:hover .pc-overlay {
        opacity: 1;
      }
      
      .photo-card:hover .pc-placeholder {
        transform: scale(1.04);
      }
      
      .strip-row {
        animation: fadeInUp 0.6s forwards;
        opacity: 0;
      }
      
      .strip-row:hover {
        background: #161618;
        border-color: #2a2a2e;
        transform: translateX(3px);
      }
      
      .hidden {
        display: none !important;
      }
    </style>

    <script define:vars={{ photosData }}>
      const PHOTOS_DATA = photosData;
      
      let currentYear = 'all';
      let currentCategory = 'all';
      let currentSearch = '';
      let currentView = 'grid';
      
      function getFilteredPhotos() {
        if (!PHOTOS_DATA) return [];
        
        let filtered = [];
        PHOTOS_DATA.years.forEach(year => {
          if (currentYear !== 'all' && year.year !== currentYear) return;
          
          year.photos.forEach(photo => {
            if (currentCategory !== 'all' && photo.category !== currentCategory) return;
            if (currentSearch) {
              const searchLower = currentSearch.toLowerCase();
              const match = photo.alt.toLowerCase().includes(searchLower) ||
                           (photo.description && photo.description.toLowerCase().includes(searchLower)) ||
                           photo.category.toLowerCase().includes(searchLower);
              if (!match) return;
            }
            filtered.push({ ...photo, year: year.year });
          });
        });
        return filtered;
      }
      
      function renderPhotos() {
        const container = document.getElementById('photoSections');
        if (!container || !PHOTOS_DATA) return;
        
        const filtered = getFilteredPhotos();
        const groupedByYear = {};
        
        filtered.forEach(photo => {
          if (!groupedByYear[photo.year]) {
            groupedByYear[photo.year] = [];
          }
          groupedByYear[photo.year].push(photo);
        });
        
        const sortedYears = Object.keys(groupedByYear).sort((a, b) => b - a);
        
        if (sortedYears.length === 0) {
          container.innerHTML = '<div class="text-center py-20 text-[#6a6260] font-mono text-sm">No photos found</div>';
          return;
        }
        
        container.innerHTML = sortedYears.map((year, index) => {
          const yearPhotos = groupedByYear[year];
          const descriptions = {
            '2026': 'Recent captures and ongoing projects',
            '2025': 'Moments from a quieter year'
          };
          
          return `
            <div class="year-section mt-13" style="animation-delay: ${index * 0.08}s">
              <div class="flex items-baseline gap-4 pb-3.5 border-b border-[#2a2a2e] mb-5">
                <span class="font-serif text-[60px] font-black text-[#2a2a2e] leading-[1] tracking-[-0.04em] select-none">${year}</span>
                <div>
                  <span class="font-mono text-[10px] tracking-[0.18em] uppercase text-[#e0aa40] block">Year ${year}</span>
                  <span class="text-[12px] text-[#6a6260] italic">${descriptions[year] || ''}</span>
                </div>
                <span class="font-mono text-[10px] text-[#3a3836] ml-auto">${yearPhotos.length} photos</span>
              </div>
              
              <div class="photo-grid grid grid-cols-[repeat(auto-fill,minmax(280px,1fr))] gap-0.5 ${currentView === 'list' ? 'hidden' : ''}">
                ${yearPhotos.map((photo, idx) => `
                  <div class="photo-card relative overflow-hidden cursor-default bg-[#121214] border border-[#1e1e22]" style="animation-delay: ${idx * 0.05}s">
                    <div class="pc-placeholder w-full aspect-[4/3] flex items-center justify-center text-[32px] opacity-[0.15] relative z-10 transition-transform duration-[400ms]">
                      ${photo.icon || '📷'}
                      <div class="pc-overlay absolute inset-0 bg-gradient-to-t from-[#08080a]/[0.92] via-[#08080a]/[0.2] to-transparent flex flex-col justify-end p-4.5">
                        <div class="font-serif text-base font-bold text-white leading-[1.3] mb-1">${photo.alt}</div>
                        <div class="flex items-center gap-2.5">
                          <span class="font-mono text-[9px] tracking-[0.1em] py-0.5 px-2 border border-white/[0.2] text-white/[0.6]">${photo.category}</span>
                          <span class="font-mono text-[9px] text-[#6a6260]">${photo.camera}</span>
                        </div>
                      </div>
                    </div>
                    <div class="p-2.5 pb-3 bg-[#121214]">
                      <div class="font-serif text-[14px] font-bold text-white mb-0.5">${photo.alt}</div>
                      <div class="font-mono text-[9px] text-[#6a6260] tracking-[0.08em]">${photo.category} · ${photo.camera}</div>
                    </div>
                  </div>
                `).join('')}
              </div>
              
              <div class="photo-strip flex flex-col gap-0.5 ${currentView === 'grid' ? 'hidden' : ''}">
                ${yearPhotos.map((photo, idx) => `
                  <div class="strip-row grid grid-cols-[80px_1fr_auto] items-center gap-5 bg-[#121214] border border-[#1e1e22] p-3.5 px-4.5 transition-all cursor-default" style="animation-delay: ${idx * 0.05}s">
                    <div class="w-20 h-13 bg-gradient-to-br from-[#0e0e10] to-[#1e1e22] flex items-center justify-center text-[18px] opacity-40 flex-shrink-0">
                      ${photo.icon || ''}
                    </div>
                    <div>
                      <div class="font-serif text-base font-bold text-white mb-1">${photo.alt}</div>
                      <div class="text-[12px] text-[#6a6260] italic">${photo.description || ''}</div>
                    </div>
                    <div class="font-mono text-[9px] text-[#3a3836] text-right whitespace-nowrap">
                      ${photo.category}<br>${photo.camera}<br>${year}
                    </div>
                  </div>
                `).join('')}
              </div>
            </div>
          `;
        }).join('');
      }
      
      function updateActiveButtons() {
        document.querySelectorAll('.year-filter').forEach(btn => {
          const year = btn.getAttribute('data-year');
          btn.classList.toggle('active', year === currentYear);
        });
        
        document.querySelectorAll('.category-tag').forEach(btn => {
          const cat = btn.getAttribute('data-category');
          btn.classList.toggle('active', cat === currentCategory);
        });
        
        document.querySelectorAll('.view-btn').forEach(btn => {
          const view = btn.getAttribute('data-view');
          btn.classList.toggle('active', view === currentView);
        });
      }
      
      // Event delegation for all buttons
      document.addEventListener('click', (e) => {
        if (e.target.closest('.year-filter')) {
          const btn = e.target.closest('.year-filter');
          currentYear = btn.getAttribute('data-year');
          updateActiveButtons();
          renderPhotos();
        }
        
        if (e.target.closest('.category-tag')) {
          const btn = e.target.closest('.category-tag');
          const category = btn.getAttribute('data-category');
          currentCategory = currentCategory === category ? 'all' : category;
          updateActiveButtons();
          renderPhotos();
        }
        
        if (e.target.closest('.view-btn')) {
          const btn = e.target.closest('.view-btn');
          currentView = btn.getAttribute('data-view');
          updateActiveButtons();
          renderPhotos();
        }
      });
      
      // Search input
      const searchInput = document.getElementById('searchInput');
      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          currentSearch = e.target.value.toLowerCase().trim();
          renderPhotos();
        });
      }
      
      // Initialize
      console.log('Photos data loaded:', PHOTOS_DATA);
      updateActiveButtons();
      renderPhotos();
    </script>
  </>
</BaseLayout>