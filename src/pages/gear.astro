---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageNav from '../components/PageNavigation.astro';
import { gearData } from '../data/gear.js';
---
<BaseLayout title="Gear | Aditya Yadav" description="My homelab and tech setup">
  <>
    <PageNav currentPage="gear" />

    <div class="min-h-screen bg-[#08080a] text-[#a89e92]">
      {/* Hero Section */}
      <div class="border-b border-[#2a2a2e]/50 py-16 px-6">
        <div class="max-w-6xl mx-auto">
          <h1 class="text-7xl font-bold mb-4 tracking-tight">
            <span class="text-white">Ge</span><span class="text-[#e0aa40] italic">ar</span>
          </h1>
          
          <p class="text-[#6a6260] text-sm mb-6 italic font-mono">
            My personal homelab, machines, and software stack. This reflects my current setup as of February 2026.
          </p>
          
          <div class="flex flex-wrap gap-4 text-xs font-mono">
            <span class="text-[#6a6260]">UPDATED <span class="text-[#e0aa40]">Feb 03, 2026</span></span>
            <span class="text-[#3a3836]">•</span>
            <span class="text-[#6a6260]">MACHINES <span class="text-[#e0aa40]">2</span></span>
            <span class="text-[#3a3836]">•</span>
            <span class="text-[#6a6260]">OS <span class="text-[#5a9870]">Ubuntu</span></span>
          </div>
        </div>
      </div>

      {/* My Machines Section */}
      <div class="py-16 px-6">
        <div class="max-w-6xl mx-auto">
          <div class="mb-8">
            <h2 class="text-3xl font-medium text-white mb-2">
              <span class="text-[#e0aa40] text-sm mr-2">01</span>
              My Machines
            </h2>
            <p class="text-[#6a6260] text-sm">
              This includes computers for my personal use as well as homelab/server things.
            </p>
          </div>

          {/* Machines Grid */}
          <div class="grid md:grid-cols-2 gap-6">
            {gearData.sections[0].items.map((machine, index) => (
              <div 
                class={`border rounded-sm p-6 ${index === 0 ? 'border-[#e0aa40]/30 bg-[#e0aa40]/5' : 'border-[#5a9870]/30 bg-[#5a9870]/5'}`}
                key={index}
              >
                <div class={`text-xs font-mono mb-3 ${index === 0 ? 'text-[#e0aa40]' : 'text-[#5a9870]'}`}>
                  {index === 0 ? 'LAPTOP · DAILY DRIVER' : 'DESKTOP · HOMELAB'}
                </div>

                <h3 class="text-2xl font-medium text-white mb-2">{machine.text}</h3>
                <p class="text-[#6a6260] text-sm mb-6">{machine.description}</p>

                <div class="space-y-3 text-sm">
                  {machine.items.map((spec, specIndex) => {
                    const [label, value] = spec.text.split(': ');
                    return (
                      <div class="flex justify-between border-b border-[#2a2a2e]/50 pb-2 last:border-0">
                        <span class="text-[#6a6260]">{label}</span>
                        <span class="text-[#ddd6cc] text-right">{value}</span>
                      </div>
                    );
                  })}
                </div>

                <div class="mt-6">
                  <span class={`inline-block px-3 py-1 text-xs font-mono rounded-sm border ${
                    index === 0 
                      ? 'border-[#5a9870]/30 text-[#5a9870] bg-[#5a9870]/10' 
                      : 'border-[#e0aa40]/30 text-[#e0aa40] bg-[#e0aa40]/10'
                  }`}>
                    • {machine.items.find(item => item.text.startsWith('OS:'))?.text.replace('OS: ', '')}
                  </span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      {/* Software Stack Section */}
      <div class="py-16 px-6 border-t border-[#2a2a2e]/50">
        <div class="max-w-6xl mx-auto">
          <div class="mb-12">
            <h2 class="text-3xl font-medium text-white mb-2">
              <span class="text-[#e0aa40] text-sm mr-2">02</span>
              Software Stack
            </h2>
          </div>

          {/* Mobile Phone & Other Services - Top Row */}
          <div class="grid md:grid-cols-2 gap-px bg-[#2a2a2e]/50 border border-[#2a2a2e]/50 mb-px">
            {/* Mobile Phone */}
            <div class="bg-[#08080a] p-6">
              <h3 class="text-xs font-mono text-[#e0aa40] mb-4 tracking-wider">MOBILE PHONE</h3>
              <ul class="space-y-3">
                <li class="flex justify-between items-center text-sm border-b border-[#2a2a2e]/50 pb-2">
                  <span class="text-[#ddd6cc]"><span class="text-[#e0aa40] mr-2">•</span>Phone</span>
                  <span class="text-[#6a6260] text-xs">Realme 13 5G</span>
                </li>
                <li class="flex justify-between items-center text-sm border-b border-[#2a2a2e]/50 pb-2">
                  <span class="text-[#ddd6cc]"><span class="text-[#e0aa40] mr-2">•</span>OS</span>
                  <span class="text-[#6a6260] text-xs">Realme UI</span>
                </li>
                <li class="text-sm">
                  <div class="text-[#ddd6cc] mb-2"><span class="text-[#e0aa40] mr-2">•</span>Apps:</div>
                  <ul class="pl-6 space-y-1">
                    {gearData.sections[1].items.find(i => i.children)?.children.map((app, idx) => (
                      <li key={idx} class="text-[#6a6260] text-xs">• {app.text}</li>
                    ))}
                  </ul>
                </li>
              </ul>
            </div>

            {/* Other Services */}
            <div class="bg-[#08080a] p-6 border-l border-[#2a2a2e]/50">
              <h3 class="text-xs font-mono text-[#e0aa40] mb-4 tracking-wider">OTHER SERVICES</h3>
              <ul class="space-y-3">
                <li class="flex justify-between items-center text-sm border-b border-[#2a2a2e]/50 pb-2">
                  <span class="text-[#ddd6cc]"><span class="text-[#e0aa40] mr-2">•</span>Code Hosting</span>
                  <span class="text-[#6a6260] text-xs">GitHub</span>
                </li>
                <li class="flex justify-between items-center text-sm border-b border-[#2a2a2e]/50 pb-2">
                  <span class="text-[#ddd6cc]"><span class="text-[#e0aa40] mr-2">•</span>Email</span>
                  <span class="text-[#6a6260] text-xs">Google</span>
                </li>
                <li class="flex justify-between items-center text-sm border-b border-[#2a2a2e]/50 pb-2">
                  <span class="text-[#ddd6cc]"><span class="text-[#e0aa40] mr-2">•</span>Search</span>
                  <span class="text-[#6a6260] text-xs">DuckDuckGo (sometimes)</span>
                </li>
                <li class="text-sm">
                  <div class="text-[#ddd6cc] mb-2"><span class="text-[#e0aa40] mr-2">•</span>VPN:</div>
                  <ul class="pl-6 space-y-1">
                    {gearData.sections[2].items.find(i => i.children)?.children.map((vpn, idx) => (
                      <li key={idx} class="text-[#6a6260] text-xs">• {vpn.text}</li>
                    ))}
                  </ul>
                </li>
                <li class="flex justify-between items-center text-sm">
                  <span class="text-[#ddd6cc]"><span class="text-[#e0aa40] mr-2">•</span>VPS</span>
                  <span class="text-[#6a6260] text-xs">Oracle Cloud Free Tier</span>
                </li>
              </ul>
            </div>
          </div>

          {/* Firewall/Router & General Software Tools - Bottom Row */}
          <div class="grid md:grid-cols-3 gap-px bg-[#2a2a2e]/50 border border-[#2a2a2e]/50">
            {/* Firewall/Router */}
            <div class="bg-[#08080a] p-6">
              <h3 class="text-xs font-mono text-[#e0aa40] mb-4 tracking-wider">FIREWALL/ROUTER</h3>
              <p class="text-[#6a6260] text-xs mb-4 leading-relaxed">
                I use my D-Link router for home networking with the stock firmware provided by the manufacturer.
              </p>
              <ul class="space-y-3">
                <li class="flex justify-between items-center text-sm border-b border-[#2a2a2e]/50 pb-2">
                  <span class="text-[#ddd6cc]"><span class="text-[#e0aa40] mr-2">•</span>Model</span>
                  <span class="text-[#6a6260] text-xs">D-Link DIR-825</span>
                </li>
                <li class="flex justify-between items-center text-sm border-b border-[#2a2a2e]/50 pb-2">
                  <span class="text-[#ddd6cc]"><span class="text-[#e0aa40] mr-2">•</span>Hardware Version</span>
                  <span class="text-[#6a6260] text-xs">G1</span>
                </li>
                <li class="flex justify-between items-center text-sm border-b border-[#2a2a2e]/50 pb-2">
                  <span class="text-[#ddd6cc]"><span class="text-[#e0aa40] mr-2">•</span>Firmware Version</span>
                  <span class="text-[#6a6260] text-xs">7</span>
                </li>
                <li class="flex justify-between items-center text-sm">
                  <span class="text-[#ddd6cc]"><span class="text-[#e0aa40] mr-2">•</span>OS</span>
                  <span class="text-[#6a6260] text-xs">Proprietary firmware</span>
                </li>
              </ul>
            </div>

            {/* General Software Tools - spanning 2 columns */}
            <div class="bg-[#08080a] p-6 border-l border-[#2a2a2e]/50 md:col-span-2">
              <h3 class="text-xs font-mono text-[#e0aa40] mb-4 tracking-wider">GENERAL SOFTWARE TOOLS</h3>
              <p class="text-[#6a6260] text-xs mb-4">
                Software that I use for practical purposes, mostly on my laptop.
              </p>
              <div class="grid md:grid-cols-2 gap-6">
                <ul class="space-y-3">
                  <li class="flex justify-between items-center text-sm border-b border-[#2a2a2e]/50 pb-2">
                    <span class="text-[#ddd6cc]"><span class="text-[#e0aa40] mr-2">•</span>Browser</span>
                    <span class="text-[#6a6260] text-xs">Tor & Zen</span>
                  </li>
                  <li class="flex justify-between items-center text-sm border-b border-[#2a2a2e]/50 pb-2">
                    <span class="text-[#ddd6cc]"><span class="text-[#e0aa40] mr-2">•</span>Documents</span>
                    <span class="text-[#6a6260] text-xs">LibreOffice</span>
                  </li>
                  <li class="text-sm border-b border-[#2a2a2e]/50 pb-2">
                    <div class="text-[#ddd6cc] mb-2"><span class="text-[#e0aa40] mr-2">•</span>Editors:</div>
                    <ul class="pl-6 space-y-1">
                      {gearData.sections[4].items.find(i => i.text.startsWith('Editors:'))?.children.map((editor, idx) => (
                        <li key={idx} class="text-[#6a6260] text-xs">• {editor.text}</li>
                      ))}
                    </ul>
                  </li>
                  <li class="flex justify-between items-center text-sm border-b border-[#2a2a2e]/50 pb-2">
                    <span class="text-[#ddd6cc]"><span class="text-[#e0aa40] mr-2">•</span>Notes</span>
                    <span class="text-[#6a6260] text-xs">website itself!!!</span>
                  </li>
                  <li class="flex justify-between items-center text-sm border-b border-[#2a2a2e]/50 pb-2">
                    <span class="text-[#ddd6cc]"><span class="text-[#e0aa40] mr-2">•</span>Password Manager</span>
                    <span class="text-[#6a6260] text-xs">google password manager</span>
                  </li>
                  <li class="flex justify-between items-center text-sm">
                    <span class="text-[#ddd6cc]"><span class="text-[#e0aa40] mr-2">•</span>Shell</span>
                    <span class="text-[#6a6260] text-xs">bash</span>
                  </li>
                </ul>
                <ul class="space-y-3">
                  <li class="text-sm border-b border-[#2a2a2e]/50 pb-2">
                    <div class="text-[#ddd6cc] mb-2"><span class="text-[#e0aa40] mr-2">•</span>Terminals:</div>
                    <ul class="pl-6 space-y-1">
                      {gearData.sections[4].items.find(i => i.text.startsWith('Terminals:'))?.children.map((term, idx) => (
                        <li key={idx} class="text-[#6a6260] text-xs">• {term.text}</li>
                      ))}
                    </ul>
                  </li>
                  <li class="text-sm border-b border-[#2a2a2e]/50 pb-2">
                    <div class="text-[#ddd6cc] mb-2"><span class="text-[#e0aa40] mr-2">•</span>AI Tools:</div>
                    <ul class="pl-6 space-y-1">
                      {gearData.sections[4].items.find(i => i.text.startsWith('AI Tools:'))?.children.map((ai, idx) => (
                        <li key={idx} class="text-[#6a6260] text-xs">• {ai.text}</li>
                      ))}
                    </ul>
                  </li>
                  <li class="text-sm border-b border-[#2a2a2e]/50 pb-2">
                    <div class="text-[#ddd6cc] mb-2"><span class="text-[#e0aa40] mr-2">•</span>AI Agent:</div>
                    <ul class="pl-6 space-y-1">
                      {gearData.sections[4].items.find(i => i.text.startsWith('AI Agent:'))?.children.map((agent, idx) => (
                        <li key={idx} class="text-[#6a6260] text-xs">• {agent.text}</li>
                      ))}
                    </ul>
                  </li>
                  <li class="flex justify-between items-center text-sm">
                    <span class="text-[#ddd6cc]"><span class="text-[#e0aa40] mr-2">•</span>Terminal Multiplexer</span>
                    <span class="text-[#6a6260] text-xs">tmux</span>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>

      {/* Footer */}
      <div class="border-t border-[#2a2a2e]/50 py-8 px-6 mt-16">
        <div class="max-w-6xl mx-auto flex flex-col md:flex-row justify-between items-center gap-4 text-xs font-mono text-[#6a6260]">
          <div>
            <span class="text-[#e0aa40]">~/gear</span> — last updated <span class="text-[#6a6260]">Feb 2026</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-[#3a3836]">built with</span>
            <span class="text-[#6a6260]">html</span>
            <span class="text-[#3a3836]">&</span>
            <span class="text-[#6a6260]">css</span>
          </div>
        </div>
      </div>

      {/* Back Link */}
      <div class="border-t border-[#2a2a2e]/50 py-6 px-6">
        <div class="max-w-6xl mx-auto">
          <a
            href="/"
            class="flex items-center gap-2 text-[#6a6260] hover:text-[#e0aa40] transition-colors text-sm"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="19" y1="12" x2="5" y2="12" /><polyline points="12 19 5 12 12 5" />
            </svg>
            Back to Home
          </a>
        </div>
      </div>
    </div>
  </>
</BaseLayout>

<style>
  ::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }
  
  ::-webkit-scrollbar-track {
    background: #08080a;
  }
  
  ::-webkit-scrollbar-thumb {
    background: #2a2a2e;
    border-radius: 4px;
  }
  
  ::-webkit-scrollbar-thumb:hover {
    background: #3a3836;
  }

  a {
    transition: all 0.2s ease;
  }
</style>