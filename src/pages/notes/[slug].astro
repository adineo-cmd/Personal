---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageNav from '../../components/PageNavigation.astro';
import { notesIndex } from '../../data/notesIndex.js';
import { marked } from 'marked';

export async function getStaticPaths() {
  const allNotes = notesIndex.categories.flatMap(cat => 
    cat.notes.map(note => ({
      params: { slug: note.slug },
      props: { note, categoryTitle: cat.title },
    }))
  );
  
  return allNotes;
}

const { note, categoryTitle } = Astro.props;
const noteContent = await import(`../../content/notes/${note.slug}.md?raw`);
const htmlContent = marked(noteContent.default);
---

<BaseLayout 
  title={`${note.title} | Notes | Aditya Yadav`} 
  description={note.excerpt || note.title}
>
  <>
    <PageNav currentPage="notes" />

    <div class="min-h-screen bg-[#08080a] text-[#ddd6cc]">
      <div class="py-16 px-6">
        <div class="max-w-4xl mx-auto">
          
          {/* Back Link */}
          <a 
            href="/notes"
            class="inline-flex items-center gap-2 text-[#6a6260] hover:text-[#e0aa40] text-sm mb-8 transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="19" y1="12" x2="5" y2="12"></line>
              <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            Back to Notes
          </a>

          {/* Note Header */}
          <header class="mb-10 pb-8 border-b border-[#2a2a2e]">
            <div class="text-sm text-[#6a6260] mb-3">{categoryTitle}</div>
            <h1 class="text-4xl font-serif text-white mb-6">{note.title}</h1>
            
            <div class="flex flex-wrap items-center gap-4 text-sm">
              <time class="text-[#6a6260]">
                {new Date(note.date).toLocaleDateString('en-US', { 
                  year: 'numeric', 
                  month: 'long', 
                  day: 'numeric' 
                })}
              </time>
              {note.tags && note.tags.length > 0 && (
                <div class="flex flex-wrap gap-2">
                  {note.tags.map((tag, index) => (
                    <span 
                      key={index}
                      class="text-xs text-[#6a6260] border border-[#2a2a2e]/50 px-2 py-1 rounded"
                    >
                      {tag}
                    </span>
                  ))}
                </div>
              )}
            </div>
          </header>

          {/* Note Content */}
          <article class="prose prose-invert prose-lg max-w-none">
            <div 
              class="text-[#ddd6cc] leading-relaxed [&_h2]:text-white [&_h2]:font-serif [&_h2]:text-2xl [&_h2]:mb-4 [&_h2]:mt-8 [&_p]:mb-4 [&_a]:text-[#e0aa40] [&_a]:hover:text-[#f0cc72] [&_code]:bg-[#0e0e10] [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:rounded [&_pre]:bg-[#0e0e10] [&_pre]:p-6 [&_pre]:rounded-lg [&_pre]:overflow-x-auto [&_blockquote]:border-l-4 [&_blockquote]:border-[#e0aa40]/30 [&_blockquote]:pl-6 [&_blockquote]:text-[#a89e92] [&_blockquote]:italic"
              set:html={htmlContent}
            />
          </article>

        </div>
      </div>

      {/* Bottom Nav */}
      <div class="border-t border-[#2a2a2e]/50 py-6">
        <div class="max-w-4xl mx-auto px-6">
          <a
            href="/notes"
            class="inline-flex items-center gap-2 text-[#6a6260] hover:text-[#e0aa40] transition-colors text-sm"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="19" y1="12" x2="5" y2="12" /><polyline points="12 19 5 12 12 5" />
            </svg>
            Back to All Notes
          </a>
        </div>
      </div>
    </div>
  </>
</BaseLayout>