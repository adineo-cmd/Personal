---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageNav from '../../components/PageNavigation.astro';
import { domains, getTechniqueCount, diffLabels } from '../../data/omnimind';

export function getStaticPaths() {
  return domains.map((d) => ({
    params: { slug: d.slug },
    props: { domain: d },
  }));
}

// beginner → intermediate → advanced → mastery (stable sort: same level keeps original order)
const DIFF_ORDER = { 'd-beg': 0, 'd-int': 1, 'd-adv': 2, 'd-mas': 3 };

const raw = Astro.props.domain;
const techniqueCount = getTechniqueCount(raw);

const domain = {
  ...raw,
  subdomains: raw.subdomains.map((sd) => ({
    ...sd,
    techniques: [...sd.techniques].sort(
      (a, b) => (DIFF_ORDER[a.diff] ?? 9) - (DIFF_ORDER[b.diff] ?? 9)
    ),
  })),
};
---

<BaseLayout title={`${domain.label} | OmniMind`} description={`${domain.sub} — ${techniqueCount} techniques in ${domain.subdomains.length} sub-domains.`}>
  <style is:global>
    :root {
      --bg: #08080a; --surf: #0e0e10; --card: #121214; --card2: #161618;
      --b1: #1e1e22; --b2: #2a2a2e;
      --t1: #ddd6cc; --t2: #a89e92; --mu: #6a6260; --dim: #3a3836;
      --gold: #e0aa40; --gold2: #f0cc72;
      --coral: #d86848; --sage: #5a9870; --slate: #5a80a8;
      --mauve: #9070a0; --rose: #c06080; --teal: #409898;
      --violet: #7060c0; --amber: #d09030; --cyan: #3090a8;
    }
    body { background: var(--bg); color: var(--t1); font-family: 'DM Sans', sans-serif; }
  </style>

  <style>
    .page { display: grid; grid-template-columns: 280px 1fr; min-height: 100vh; }

    /* ── SIDEBAR (desktop only) ── */
    .sidebar {
      background: var(--surf); border-right: 1px solid var(--b2);
      position: sticky; top: 0; height: 100vh; overflow: hidden;
      display: flex; flex-direction: column;
    }
    .sidebar::-webkit-scrollbar { width: 3px; }
    .sidebar::-webkit-scrollbar-thumb { background: var(--b2); }

    .sb-top { padding: 28px 20px 20px; border-bottom: 1px solid var(--b1); }
    .sb-brand { display: flex; align-items: center; gap: 10px; margin-bottom: 18px; text-decoration: none; }
    .sb-icon { font-size: 22px; }
    .sb-title { font-family: 'Playfair Display', serif; font-size: 18px; font-weight: 700; color: #fff; }
    .sb-sub { font-family: 'DM Mono', monospace; font-size: 8px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--mu); margin-top: 2px; }

    .sb-search-wrap { padding: 12px 16px; border-bottom: 1px solid var(--b1); }
    .sb-search {
      width: 100%; padding: 8px 12px; background: var(--card);
      border: 1px solid var(--b2); color: var(--t1); font-size: 12px; outline: none;
    }
    .sb-search:focus { border-color: var(--gold); }
    .sb-search::placeholder { color: var(--mu); }

    .sb-nav { flex: 1; overflow-y: auto; padding: 8px 0 32px; }
    .sb-nav::-webkit-scrollbar { width: 3px; }
    .sb-nav::-webkit-scrollbar-thumb { background: var(--b2); }

    .nav-group-label {
      font-family: 'DM Mono', monospace; font-size: 8px; letter-spacing: 0.22em;
      text-transform: uppercase; color: var(--dim); padding: 12px 20px 6px;
    }
    .nav-item {
      display: flex; align-items: center; gap: 10px;
      padding: 8px 20px; cursor: pointer; transition: all 0.15s;
      border-left: 2px solid transparent; text-decoration: none; color: var(--t2);
    }
    .nav-item:hover { background: var(--card); color: var(--t2); }
    .nav-item.active { background: rgba(224, 170, 64, 0.07); border-left-color: var(--gold); color: var(--gold); }
    .ni-icon { font-size: 14px; flex-shrink: 0; width: 18px; text-align: center; }
    .ni-label { font-size: 12.5px; flex: 1; }
    .ni-count { font-family: 'DM Mono', monospace; font-size: 9px; color: var(--dim); }

    /* ── MAIN ── */
    .main { overflow-y: auto; height: 100vh; }
    .main-inner { max-width: 940px; margin: 0 auto; padding: 0 40px 100px; }

    .sec-head {
      display: flex; align-items: center; gap: 14px;
      padding: 40px 0 20px; border-bottom: 1px solid var(--b2); margin-bottom: 8px;
    }
    .back-btn {
      font-family: 'DM Mono', monospace; font-size: 10px; letter-spacing: 0.12em;
      text-transform: uppercase; padding: 7px 14px; border: 1px solid var(--b2);
      background: transparent; color: var(--mu); cursor: pointer;
      transition: all 0.15s; margin-right: 12px; text-decoration: none;
      display: inline-flex; align-items: center;
    }
    .back-btn:hover { border-color: var(--gold); color: var(--gold); }
    .sec-icon { font-size: 26px; }
    .sec-info { flex: 1; }
    .sec-title { font-family: 'Playfair Display', serif; font-size: 28px; font-weight: 700; color: #fff; }
    .sec-sub { font-size: 13px; color: var(--mu); font-style: italic; margin-top: 2px; }
    .sec-badge {
      font-family: 'DM Mono', monospace; font-size: 9px; letter-spacing: 0.12em;
      padding: 4px 12px; border: 1px solid var(--b2); color: var(--mu); white-space: nowrap;
    }

    /* ── Subdomain header (links-page style) ── */
    .subdomain-head {
      display: flex; align-items: baseline; justify-content: space-between; gap: 12px;
      margin: 44px 0 0; padding-bottom: 10px; border-bottom: 1px solid var(--b2);
    }
    .sdh-title { font-family: 'Playfair Display', serif; font-size: 20px; font-weight: 700; color: var(--t1); }
    .sdh-count { font-family: 'DM Mono', monospace; font-size: 9px; color: var(--dim); white-space: nowrap; }

    /* ── Technique rows (no cards) ── */
    .techniques-list { display: flex; flex-direction: column; gap: 15px; padding: 18px 0 4px; }

    .tech-item { cursor: pointer; }

    .ti-main { font-size: 13.5px; line-height: 1.75; }

    /* highlighted topic name */
    .ti-name {
      font-family: 'DM Mono', monospace; font-size: 13px; font-weight: 700;
      color: var(--gold2); transition: color 0.15s;
    }
    .tech-item:hover .ti-name { color: var(--gold); text-decoration: underline; text-underline-offset: 4px; }

    .ti-dash { color: var(--dim); margin: 0 6px; user-select: none; }
    .ti-desc { color: var(--t2); }

    /* difficulty pill */
    .diff {
      display: inline-block; font-family: 'DM Mono', monospace; font-size: 8px;
      letter-spacing: 0.1em; text-transform: uppercase;
      padding: 1px 7px; border-radius: 20px; margin-right: 8px; vertical-align: 1px;
    }
    .d-beg { background: rgba(90, 152, 112, 0.12); color: var(--sage); border: 1px solid rgba(90, 152, 112, 0.3); }
    .d-int { background: rgba(224, 170, 64, 0.1); color: var(--gold); border: 1px solid rgba(224, 170, 64, 0.25); }
    .d-adv { background: rgba(216, 104, 72, 0.1); color: var(--coral); border: 1px solid rgba(216, 104, 72, 0.25); }
    .d-mas { background: rgba(144, 112, 160, 0.1); color: var(--mauve); border: 1px solid rgba(144, 112, 160, 0.25); }

    /* expandable detail — smooth open, RAPID close */
    .tc-expand {
      max-height: 0; overflow: hidden;
      transition: max-height 0.1s ease-out, padding 0.1s ease-out; /* instant collapse */
    }
    .tech-item.expanded .tc-expand {
      max-height: 320px; padding-top: 8px;
      transition: max-height 0.25s ease-in, padding 0.2s ease-in; /* smooth open */
    }

    .te-row { margin-bottom: 8px; font-size: 12px; color: var(--mu); line-height: 1.65; }
    .te-row span {
      font-family: 'DM Mono', monospace; font-size: 8px; letter-spacing: 0.12em;
      text-transform: uppercase; color: var(--gold); font-weight: 700;
      display: block; margin-bottom: 2px;
    }
    /* bold highlighted values */
    .te-row strong { color: var(--t1); font-weight: 700; }

    .cat-bar { display: none; }

    footer {
      border-top: 1px solid var(--b2); padding: 28px 40px;
      font-family: 'DM Mono', monospace; font-size: 10px; letter-spacing: 0.1em;
      color: var(--mu); display: flex; justify-content: space-between; align-items: center;
      max-width: 940px; margin: 40px auto 0;
    }
    footer a { color: var(--mu); text-decoration: none; }
    footer a:hover { color: var(--gold); }

    /* ── MOBILE ── */
    @media (max-width: 768px) {
      .page { grid-template-columns: 1fr; }
      .sidebar { display: none !important; }

      .cat-bar {
        display: flex; flex-wrap: nowrap !important;
        overflow-x: auto !important; overflow-y: hidden;
        gap: 10px; padding: 12px 16px;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none; white-space: nowrap;
        background: var(--surf); border-bottom: 1px solid var(--b2);
      }
      .cat-bar::-webkit-scrollbar { display: none; }
      .cat-bar .chip {
        display: inline-flex; flex-shrink: 0;
        padding: 10px 18px; border: 1px solid var(--b2); border-radius: 20px;
        background: var(--card); color: var(--t2); text-decoration: none;
        font-size: 13px; font-weight: 500; white-space: nowrap;
        transition: all 0.2s ease;
      }
      .cat-bar .chip:hover, .cat-bar .chip:active { background: var(--card2); border-color: var(--b1); }
      .cat-bar .chip.active { background: rgba(224, 170, 64, 0.15); color: var(--gold); border-color: var(--gold); }

      .main-inner { padding: 0 20px 60px; }
      .sec-head { padding: 28px 0 16px; flex-wrap: wrap; }
      .sec-title { font-size: 22px; }
      .sec-sub { font-size: 12px; }
      .back-btn { padding: 6px 12px; font-size: 9px; }

      .subdomain-head { margin-top: 32px; }
      .sdh-title { font-size: 17px; }

      .techniques-list { gap: 13px; padding-top: 14px; }
      .ti-main { font-size: 12.5px; }
      .ti-name { font-size: 12px; }
      .te-row { font-size: 11.5px; }
      .te-row strong { font-size: 11.5px; }

      footer { flex-direction: column; gap: 8px; text-align: center; padding: 24px 20px; }
    }
  </style>

  <script>
    function filterSidebar(q: string) {
      const filter = q.toLowerCase().trim();
      const items = document.querySelectorAll<HTMLElement>('#sidebarNav .nav-item');
      items.forEach(item => {
        const text = item.textContent?.toLowerCase() || '';
        item.style.display = !filter || text.includes(filter) ? 'flex' : 'none';
      });
    }

    document.addEventListener('DOMContentLoaded', () => {
      // click to open, click again to close instantly (works on desktop + mobile)
      document.querySelectorAll('.tech-item').forEach(item => {
        item.addEventListener('click', () => item.classList.toggle('expanded'));
      });
    });
  </script>

  <PageNav currentPage="mind" />

  <div class="page">
    <!-- Desktop sidebar -->
    <aside class="sidebar">
      <div class="sb-top">
        <a href="/mind" class="sb-brand">
          <span class="sb-icon">🧠</span>
          <div>
            <div class="sb-title">OmniMind</div>
            <div class="sb-sub">Universal Mastery System</div>
          </div>
        </a>
      </div>

      <div class="sb-search-wrap">
        <input class="sb-search" type="text" placeholder="Search domains…" oninput="filterSidebar(this.value)">
      </div>

      <nav class="sb-nav" id="sidebarNav">
        <div class="nav-group-label">Navigation</div>
        <a href="/mind" class="nav-item">
          <span class="ni-icon">🏠</span>
          <span class="ni-label">Overview</span>
        </a>

        {(() => {
          const groups = [...new Set(domains.map(d => d.group))];
          return groups.map(group => (
            <>
              <div class="nav-group-label">{group}</div>
              {domains.filter(d => d.group === group).map(d => (
                <a href={`/mind/${d.slug}`} class={`nav-item ${d.slug === domain.slug ? 'active' : ''}`}>
                  <span class="ni-icon">{d.icon}</span>
                  <span class="ni-label">{d.label}</span>
                  <span class="ni-count">{getTechniqueCount(d)}</span>
                </a>
              ))}
            </>
          ));
        })()}
      </nav>
    </aside>

    <!-- Mobile horizontal chips -->
    <nav class="cat-bar">
      <a href="/mind" class="chip">🏠 Overview</a>
      {domains.map(d => (
        <a href={`/mind/${d.slug}`} class={`chip ${d.slug === domain.slug ? 'active' : ''}`}>
          {d.icon} {d.label}
        </a>
      ))}
    </nav>

    <!-- Main -->
    <main class="main">
      <div class="main-inner">
        <div class="sec-head">
          <a href="/mind" class="back-btn">← Back</a>
          <span class="sec-icon">{domain.icon}</span>
          <div class="sec-info">
            <div class="sec-title">{domain.label}</div>
            <div class="sec-sub">{domain.sub}</div>
          </div>
          <span class="sec-badge">{techniqueCount} techniques</span>
        </div>

        {domain.subdomains.map((sd) => (
          <>
            <div class="subdomain-head">
              <span class="sdh-title">{sd.name}</span>
              <span class="sdh-count">{sd.techniques.length} techniques</span>
            </div>

            <div class="techniques-list">
              {sd.techniques.map((t) => (
                <div class="tech-item">
                  <div class="ti-main">
                    <span class={`diff ${t.diff}`}>{diffLabels[t.diff]}</span>
                    <span class="ti-name">{t.name}</span>
                    <span class="ti-dash">—</span>
                    <span class="ti-desc">{t.desc}</span>
                  </div>
                  <div class="tc-expand">
                    {t.timing && <p class="te-row"><span>⏱ timing</span><strong>{t.timing}</strong></p>}
                    {t.recovery && <p class="te-row"><span>♻ recovery</span><strong>{t.recovery}</strong></p>}
                    {t.example && <p class="te-row"><span>→ example</span><strong>{t.example}</strong></p>}
                  </div>
                </div>
              ))}
            </div>
          </>
        ))}

        <footer>
          <a href="/mind">← back to overview</a>
          <span>{domain.label} · {techniqueCount} techniques</span>
        </footer>
      </div>
    </main>
  </div>
</BaseLayout>