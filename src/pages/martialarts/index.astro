---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageNav from '../../components/PageNavigation.astro';
import { martialArtsRegistry, universalSystemData } from '../../data/martial-arts/index.js';

// Sort styles alphabetically by default for better UX
const styles = [...martialArtsRegistry].sort((a, b) => a.name.localeCompare(b.name));
const universal = universalSystemData;
---

<BaseLayout title="Martial Arts Encyclopedia | Aditya Yadav" description="Explore techniques, forms, and principles from martial arts worldwide">
  <Fragment>
    <PageNav currentPage="martialarts" />

    <div class="min-h-screen bg-[#08080a]">
      <div class="text-[#a89e92] py-16 px-6" style="font-family: 'Courier New', Courier, monospace;">
        <div class="max-w-6xl mx-auto">
          
          <!-- Header Section -->
          <header class="mb-12">
            <h1 class="text-5xl font-serif mb-6 text-[#ddd6cc]">
              <span class="text-white">🥋 Martial</span><span class="text-[#e0aa40] italic"> Arts</span>
              <span class="text-[#ddd6cc]"> Encyclopedia</span>
            </h1>
            <p class="text-xs text-[#6a6260] mb-2">Updated: September 01, 2026</p>
            <p class="text-[#a89e92] text-sm mb-8 leading-relaxed max-w-3xl">
              Decentralized knowledge base. Each martial art lives in its own module. 
              Explore detailed curriculums, anatomy targets, progression paths, and essential knowledge for every style.
            </p>

            <!-- Search Bar -->
            <div class="relative max-w-xl group">
              <input 
                type="text" 
                id="styleSearch"
                placeholder="Search styles (e.g., Karate, BJJ, Tai Chi, Universal)..."
                class="w-full px-4 py-3 bg-[#0e0e10] border border-[#2a2a2e] rounded-lg text-[#ddd6cc] placeholder-[#6a6260] focus:outline-none focus:border-[#e0aa40] focus:ring-1 focus:ring-[#e0aa40]/50 transition-all group-hover:border-[#2a2a2e]"
              />
              <svg class="absolute right-3 top-3.5 w-5 h-5 text-[#6a6260] pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>
          </header>

          <!-- Styles Grid -->
          <div id="stylesGrid" class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
            
            {/* 🌟 UNIVERSAL COMBAT SYSTEM - HIGHLIGHTED MASTER CARD */}
            {universal && (
              <a 
                href={`/martialarts/${universal.id.trim()}`}
                class="style-card group md:col-span-2 lg:col-span-3 block border-2 border-[#e0aa40]/30 rounded-xl p-6 bg-gradient-to-br from-[#1a1612] to-[#0e0e10] hover:border-[#e0aa40] hover:shadow-[0_0_30px_rgba(224,170,64,0.15)] transition-all duration-300 relative overflow-hidden"
                data-search-text={`${universal.name} ${universal.origin} ${universal.description} master system universal`.toLowerCase()}
              >
                {/* Decorative Corner Accents */}
                <div class="absolute top-0 left-0 w-12 h-12 border-t-2 border-l-2 border-[#e0aa40]/60 rounded-tl-xl pointer-events-none"></div>
                <div class="absolute bottom-0 right-0 w-12 h-12 border-b-2 border-r-2 border-[#e0aa40]/60 rounded-br-xl pointer-events-none"></div>

                <div class="flex flex-col md:flex-row md:items-center gap-6">
                  <div class="flex-shrink-0">
                    <div class="text-5xl bg-[#0e0e10] p-3 rounded-xl border border-[#e0aa40]/30 shadow-inner group-hover:scale-110 transition-transform duration-300">
                      {universal.icon}
                    </div>
                  </div>
                  
                  <div class="flex-1 min-w-0">
                    <div class="flex flex-wrap items-center gap-3 mb-2">
                      <h3 class="text-2xl font-bold text-[#e0aa40] group-hover:text-white transition-colors">
                        {universal.name}
                      </h3>
                      <span class="text-[10px] px-2 py-1 rounded-full bg-[#e0aa40]/10 text-[#e0aa40] border border-[#e0aa40]/30 uppercase font-bold tracking-widest">
                        Master System
                      </span>
                    </div>
                    <p class="text-xs text-[#a89e92] font-mono mb-3">{universal.origin}</p>
                    <p class="text-sm text-[#ddd6cc] leading-relaxed mb-4 max-w-3xl">
                      {universal.description}
                    </p>
                    
                    {/* Quick Stats / Pillars */}
                    <div class="flex flex-wrap gap-x-6 gap-y-2 text-xs text-[#a89e92] mb-4">
                      <div class="flex items-center gap-1.5">
                        <span class="text-[#e0aa40]">⚔️</span>
                        <span class="font-bold text-[#ddd6cc]">1000+</span> Techniques
                      </div>
                      <div class="flex items-center gap-1.5">
                        <span class="text-[#e0aa40]">🎯</span>
                        <span class="font-bold text-[#ddd6cc]">7</span> Precision Categories
                      </div>
                      <div class="flex items-center gap-1.5">
                        <span class="text-[#e0aa40]">🧠</span>
                        <span class="font-bold text-[#ddd6cc]">100+</span> Meta-Frameworks
                      </div>
                      <div class="flex items-center gap-1.5">
                        <span class="text-[#e0aa40]">🔄</span>
                        <span class="font-bold text-[#ddd6cc]">80+</span> Recovery Protocols
                      </div>
                    </div>

                    {/* Key Principles */}
                    {universal.keyPrinciples?.length > 0 && (
                      <div class="pt-4 border-t border-[#2a2a2e]/50">
                        <div class="text-[10px] uppercase tracking-wider text-[#6a6260] mb-2">Core Principles</div>
                        <div class="flex flex-wrap gap-2">
                          {universal.keyPrinciples.map(principle => (
                            <span class="text-[10px] px-2 py-0.5 rounded-full bg-[#e0aa40]/5 text-[#e0aa40] border border-[#e0aa40]/20">
                              {principle}
                            </span>
                          ))}
                        </div>
                      </div>
                    )}
                  </div>

                  <div class="flex-shrink-0 hidden md:flex items-center">
                    <span class="text-[#6a6260] group-hover:text-[#e0aa40] group-hover:translate-x-1 transition-all text-2xl">→</span>
                  </div>
                </div>
              </a>
            )}

            {/* REGULAR STYLES */}
            {styles.map(style => (
              <a 
                href={`/martialarts/${style.id.trim()}`}
                class="style-card group block border border-[#2a2a2e] rounded-lg p-5 bg-[#0e0e10]/30 hover:bg-[#121214] hover:border-[#3a3a3e] transition-all duration-200 relative overflow-hidden"
                data-search-text={`${style.name} ${style.origin} ${style.description}`.toLowerCase()}
              >
                <!-- Top Accent Line (Dynamic color) -->
                <div class={`absolute top-0 left-0 w-full h-1 ${style.color?.split(' ')[0] || 'bg-[#2a2a2e]'} opacity-0 group-hover:opacity-100 transition-opacity`}></div>

                <div class="flex items-start gap-4 mb-3">
                  <span class="text-3xl bg-[#0e0e10] p-2 rounded-lg border border-[#2a2a2e] group-hover:border-[#3a3a3e] transition-colors shadow-sm">{style.icon}</span>
                  <div class="flex-1 min-w-0">
                    <h3 class="text-lg font-medium text-[#ddd6cc] group-hover:text-white transition-colors truncate">{style.name}</h3>
                    <p class="text-xs text-[#6a6260] mt-0.5 font-mono">{style.origin}</p>
                  </div>
                </div>
                
                <p class="text-sm text-[#a89e92] line-clamp-2 mb-4 leading-relaxed">{style.description}</p>
                
                {style.keyPrinciples?.length > 0 && (
                  <div class="pt-3 border-t border-[#2a2a2e]/50 group-hover:border-[#2a2a2e] transition-colors">
                    <div class="text-[10px] uppercase tracking-wider text-[#6a6260] mb-2">Core Principles</div>
                    <div class="flex flex-wrap gap-1.5">
                      {style.keyPrinciples.slice(0, 3).map(principle => (
                        <span class="text-[10px] px-2 py-0.5 rounded-full bg-[#1e1e22] text-[#6a6260] border border-[#2a2a2e] truncate">
                          {principle}
                        </span>
                      ))}
                      {style.keyPrinciples.length > 3 && (
                        <span class="text-[10px] px-1.5 py-0.5 text-[#6a6260]">+{style.keyPrinciples.length - 3}</span>
                      )}
                    </div>
                  </div>
                )}
              </a>
            ))}
          </div>

          <!-- Empty State (Hidden by default) -->
          <div id="emptyState" class="hidden text-center py-20 border border-dashed border-[#2a2a2e] rounded-lg bg-[#0e0e10]/20">
            <div class="text-4xl mb-4 opacity-50">🔍</div>
            <h3 class="text-lg font-medium text-[#ddd6cc] mb-2">No styles found</h3>
            <p class="text-[#6a6260] text-sm">Try adjusting your search terms</p>
          </div>

          <!-- Stats Footer -->
          <div class="mt-16 pt-6 border-t border-[#2a2a2e] flex flex-wrap justify-between items-center text-xs text-[#6a6260] font-mono">
            <div>
              <span class="font-bold text-[#a89e92]">{styles.length + (universal ? 1 : 0)}</span> Total Martial Arts Systems
            </div>
            <div>
              Database: <span class="font-bold text-[#a89e92]">Decentralized</span>
            </div>
          </div>

        </div>
      </div>
    </div>

    <!-- Lightweight Client-Side Search Script -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const searchInput = document.getElementById('styleSearch');
        const cards = document.querySelectorAll('.style-card');
        const emptyState = document.getElementById('emptyState');
        const grid = document.getElementById('stylesGrid');

        searchInput?.addEventListener('input', (e) => {
          const query = e.target.value.toLowerCase().trim();
          let visibleCount = 0;

          cards.forEach(card => {
            // Use the robust data-search-text attribute for instant, reliable filtering
            const searchText = card.dataset.searchText || '';
            const isVisible = searchText.includes(query);
            
            if (isVisible) {
              card.style.display = ''; // Reset to default grid behavior
              visibleCount++;
            } else {
              card.style.display = 'none';
            }
          });

          if (visibleCount === 0 && query !== '') {
            grid.classList.add('hidden');
            emptyState.classList.remove('hidden');
          } else {
            grid.classList.remove('hidden');
            emptyState.classList.add('hidden');
          }
        });
      });
    </script>
  </Fragment>
</BaseLayout>