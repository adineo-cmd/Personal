---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageNav from '../../components/PageNavigation.astro';
import { mobilityFlexibilityRegistry } from '../../data/mobility-flexibility/index.js';
import { renderSystemPage } from '../../data/mobility-flexibility/renderer.js';

export async function getStaticPaths() {
  return mobilityFlexibilityRegistry.map(system => ({
    params: { system: system.id },
    props: { systemData: system }
  }));
}

const { systemData } = Astro.props;
const { html } = renderSystemPage(systemData);
---

<BaseLayout title={`${systemData.name} Framework`} description={systemData.description}>
    <PageNav currentPage="mobility" />

    <div class="min-h-screen bg-[#08080a]">
      <div class="text-[#a89e92] py-16 px-6" style="font-family: 'Courier New', Courier, monospace;">
        <div class="max-w-7xl mx-auto">
          
          <div class="mb-8 pb-6 border-b border-[#2a2a2e]">
            <a href="/mobility" class="text-xs text-[#6a6260] hover:text-[#e0aa40] mb-4 inline-flex items-center gap-1 transition-colors">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
              Back to Directory
            </a>
            
            <div class="flex items-start gap-4">
              <span class="text-4xl bg-[#0e0e10] p-3 rounded-lg border border-[#2a2a2e]">{systemData.icon}</span>
              <div>
                <h1 class="text-4xl font-serif text-white mb-2">{systemData.name}</h1>
                <p class="text-sm text-[#6a6260] mb-3 font-mono">{systemData.origin}</p>
                <p class="text-[#a89e92] text-sm leading-relaxed max-w-2xl">{systemData.description}</p>
              </div>
            </div>
            
            <div set:html={html.principles}></div>
          </div>

          <div set:html={html.toc}></div>

          <main class="space-y-16">
            <div set:html={html.techniques || ''}></div>
            <div set:html={html.assessments || ''}></div>
            <div set:html={html.periodization || ''}></div>
            <div set:html={html.templates || ''}></div>
            <div set:html={html.prescriptions || ''}></div>
            <div set:html={html.integration || ''}></div>
            <div set:html={html.tracking || ''}></div>
          </main>
        </div>
      </div>

      <div class="border-t border-[#2a2a2e]/50 py-6">
        <div class="max-w-7xl mx-auto px-6">
          <a href="/" class="flex items-center gap-2 text-[#6a6260] hover:text-[#e0aa40] transition-colors text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="19" y1="12" x2="5" y2="12" /><polyline points="12 19 5 12 12 5" />
            </svg>
            Back to Home
          </a>
        </div>
      </div>
    </div>

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.toc-link').forEach(link => {
          link.addEventListener('click', e => {
            e.preventDefault();
            const target = document.getElementById(link.getAttribute('href').substring(1));
            if (target) {
              target.scrollIntoView({ behavior: 'smooth', block: 'start' });
              history.pushState(null, null, `#${target.id}`);
            }
          });
        });

        const sections = document.querySelectorAll('section[id]');
        const links = document.querySelectorAll('.toc-link');
        const observer = new IntersectionObserver(entries => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              links.forEach(l => {
                l.style.backgroundColor = 'transparent';
                l.style.color = '#6a6260';
                l.style.borderColor = '#2a2a2e';
              });
              const active = document.querySelector(`.toc-link[href="#${entry.target.id}"]`);
              if (active) {
                active.style.backgroundColor = '#121214';
                active.style.color = '#e0aa40';
                active.style.borderColor = '#e0aa40';
              }
            }
          });
        }, { rootMargin: '-20% 0px -70% 0px' });

        sections.forEach(s => observer.observe(s));
      });
    </script>
</BaseLayout>