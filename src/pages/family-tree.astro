---
// src/pages/family-tree.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import PageNavigation from '../components/PageNavigation.astro';
import { familyLineage } from '../data/family.js';
---

<BaseLayout title="Family Tree | Aditya Yadav" description="My direct lineage">
  <>
    <PageNavigation currentPage="family-tree" />

    <div class="min-h-screen bg-[#08080a] relative font-['DM_Sans',sans-serif]">
      <!-- Noise texture overlay -->
      <div class="fixed inset-0 pointer-events-none z-[999] opacity-[0.035]" style="background-image: url('data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 width=%27200%27 height=%27200%27%3E%3Cfilter id=%27n%27%3E%3CfeTurbulence type=%27fractalNoise%27 baseFrequency=%270.85%27 numOctaves=%274%27/%3E%3CfeColorMatrix type=%27saturate%27 values=%270%27/%3E%3C/filter%3E%3Crect width=%27200%27 height=%27200%27 filter=%27url(%23n)%27/%3E%3C/svg%3E');"></div>
      
      <div class="relative z-10 max-w-[1400px] mx-auto px-4 md:px-9 pb-25">
        
        <!-- Header -->
        <header class="py-10 md:py-20 pb-8 md:pb-13 border-b border-[#2a2a2e]">
          <p class="font-['DM_Mono',monospace] text-[10px] tracking-[0.3em] uppercase text-[#e0aa40] mb-5 flex items-center gap-2.5">
            Direct Lineage
            <span class="w-[60px] h-px bg-[#e0aa40] opacity-40"></span>
          </p>
          <h1 class="font-['Playfair_Display',serif] text-[48px] md:text-[64px] lg:text-[116px] font-black leading-[0.87] tracking-[-0.03em] text-white mb-4.5">
            Family<br><span class="text-[#e0aa40] italic">Tree</span>
          </h1>
          <p class="text-[14px] md:text-[15px] text-[#a89e92] max-w-[520px] leading-[1.7] font-light">
            Direct lineage: paternal &amp; maternal lines, chronologically ordered. A record of where I come from.
          </p>
          
          <!-- Stats -->
          <div class="grid grid-cols-2 md:grid-cols-4 border border-[#2a2a2e] mt-8 md:mt-10">
            <div class="p-4 md:p-[18px] border-r border-b md:border-b-0 border-[#2a2a2e] hover:bg-[#121214] transition-colors">
              <span class="font-['Playfair_Display',serif] text-2xl md:text-[32px] font-bold leading-none block mb-1 text-[#e0aa40]">14</span>
              <span class="font-['DM_Mono',monospace] text-[9px] tracking-[0.18em] uppercase text-[#6a6260]">Known Members</span>
            </div>
            <div class="p-4 md:p-[18px] border-r border-b md:border-b-0 border-[#2a2a2e] hover:bg-[#121214] transition-colors">
              <span class="font-['Playfair_Display',serif] text-2xl md:text-[32px] font-bold leading-none block mb-1 text-[#5a80a8]">4</span>
              <span class="font-['DM_Mono',monospace] text-[9px] tracking-[0.18em] uppercase text-[#6a6260]">Generations</span>
            </div>
            <div class="p-4 md:p-[18px] border-r border-b md:border-b-0 border-[#2a2a2e] hover:bg-[#121214] transition-colors">
              <span class="font-['Playfair_Display',serif] text-2xl md:text-[32px] font-bold leading-none block mb-1 text-[#5a9870]">50/50</span>
              <span class="font-['DM_Mono',monospace] text-[9px] tracking-[0.18em] uppercase text-[#6a6260]">Pat / Mat</span>
            </div>
            <div class="p-4 md:p-[18px] hover:bg-[#121214] transition-colors">
              <span class="font-['Playfair_Display',serif] text-2xl md:text-[32px] font-bold leading-none block mb-1 text-[#d86848]">AZM</span>
              <span class="font-['DM_Mono',monospace] text-[9px] tracking-[0.18em] uppercase text-[#6a6260]">Origin · UP</span>
            </div>
          </div>
        </header>

        <!-- Toolbar -->
        <div class="flex items-center gap-5 flex-wrap mt-8 md:mt-12 mb-6 md:mb-8 pb-5 border-b border-[#2a2a2e]">
          <div class="flex gap-4 md:gap-8 flex-wrap flex-1">
            <div class="flex items-center gap-2 font-['DM_Mono',monospace] text-[10px] text-[#6a6260] tracking-[0.06em]">
              <div class="w-2.5 h-2.5 rounded-full bg-[#5a80a8]"></div>
              <span>Paternal</span>
            </div>
            <div class="flex items-center gap-2 font-['DM_Mono',monospace] text-[10px] text-[#6a6260] tracking-[0.06em]">
              <div class="w-2.5 h-2.5 rounded-full bg-[#e0aa40]"></div>
              <span>Maternal</span>
            </div>
            <div class="flex items-center gap-2 font-['DM_Mono',monospace] text-[10px] text-[#6a6260] tracking-[0.06em]">
              <div class="w-2.5 h-2.5 rounded-full bg-[#5a9870]"></div>
              <span>Self</span>
            </div>
            <div class="flex items-center gap-2 font-['DM_Mono',monospace] text-[10px] text-[#6a6260] tracking-[0.06em]">
              <div class="w-2.5 h-2.5 rounded-full border border-[#2a2a2e]"></div>
              <span>Unknown</span>
            </div>
          </div>
          <div class="flex gap-px">
            <button id="btnTree" class="view-btn active font-['DM_Mono',monospace] text-[10px] tracking-[0.1em] uppercase py-2.25 px-4 border border-[#e0aa40] bg-[rgba(224,170,64,0.06)] text-[#e0aa40] cursor-pointer transition-all" data-view="tree">⊛ Tree</button>
            <button id="btnList" class="view-btn font-['DM_Mono',monospace] text-[10px] tracking-[0.1em] uppercase py-2.25 px-4 border border-[#2a2a2e] bg-transparent text-[#6a6260] cursor-pointer transition-all hover:text-[#e0aa40] hover:border-[#e0aa40]" data-view="list">≡ List</button>
          </div>
        </div>

        <!-- Tree View -->
        <div id="treeView" class="view-section overflow-x-auto pb-5 -mx-4 md:-mx-9 px-4 md:px-9">
          <div class="tree-canvas relative min-w-[1400px] pb-5" id="canvas">
            <svg class="tree-svg absolute inset-0 w-full h-full pointer-events-none z-0" id="svg" xmlns="http://www.w3.org/2000/svg"></svg>
            
            <!-- G4 - Great Grandparents (8 people) -->
            <div class="gen-row flex justify-start items-start relative z-10 mb-12 md:mb-20 pl-8 md:pl-16" id="rG4">
              {familyLineage[0]?.members.map((member, idx) => (
                <div id={`nG4_${idx}`} class={`pnode bg-[#121214] border border-[#1e1e22] p-3 w-[160px] md:w-[180px] flex-shrink-0 relative transition-all cursor-default mx-1 hover:border-[#2a2a2e] hover:bg-[#161618] hover:-translate-y-1 hover:shadow-[0_8px_28px_rgba(0,0,0,0.5)] hover:z-20 border-t-2 ${member.side === 'paternal' ? 'border-t-[#5a80a8]' : member.side === 'maternal' ? 'border-t-[#e0aa40]' : 'border-t-[#5a9870]'}`}>
                  <div class={`font-['DM_Mono',monospace] text-[7px] tracking-[0.08em] uppercase leading-[1.4] mb-1.5 ${member.side === 'paternal' ? 'text-[rgba(90,128,168,0.7)]' : member.side === 'maternal' ? 'text-[rgba(224,170,64,0.65)]' : 'text-[rgba(90,152,112,0.7)]'}`}>{member.role}</div>
                  <div class="font-['Playfair_Display',serif] text-[14px] md:text-[15px] font-bold text-white leading-[1.25] mb-1.5">{member.name}</div>
                  <div class="font-['DM_Mono',monospace] text-[8px] text-[#e0aa40]">{member.place}</div>
                </div>
              ))}
            </div>

            <!-- G3 - Grandparents (4 people) -->
            <div class="gen-row flex justify-center items-start relative z-10 mb-12 md:mb-20 gap-12 md:gap-24" id="rG3">
              {familyLineage[1]?.members.map((member, idx) => (
                <div id={`nG3_${idx}`} class={`pnode bg-[#121214] border border-[#1e1e22] p-3 w-[160px] md:w-[180px] flex-shrink-0 relative transition-all cursor-default mx-1 hover:border-[#2a2a2e] hover:bg-[#161618] hover:-translate-y-1 hover:shadow-[0_8px_28px_rgba(0,0,0,0.5)] hover:z-20 border-t-2 ${member.side === 'paternal' ? 'border-t-[#5a80a8]' : member.side === 'maternal' ? 'border-t-[#e0aa40]' : 'border-t-[#5a9870]'}`}>
                  <div class={`font-['DM_Mono',monospace] text-[7px] tracking-[0.08em] uppercase leading-[1.4] mb-1.5 ${member.side === 'paternal' ? 'text-[rgba(90,128,168,0.7)]' : member.side === 'maternal' ? 'text-[rgba(224,170,64,0.65)]' : 'text-[rgba(90,152,112,0.7)]'}`}>{member.role}</div>
                  <div class="font-['Playfair_Display',serif] text-[14px] md:text-[15px] font-bold text-white leading-[1.25] mb-1.5">{member.name}</div>
                  <div class="font-['DM_Mono',monospace] text-[8px] text-[#e0aa40]">{member.place}</div>
                </div>
              ))}
            </div>

            <!-- G2 - Parents (2 people) -->
            <div class="gen-row flex justify-center items-start relative z-10 mb-12 md:mb-20 gap-[120px] md:gap-[200px]" id="rG2">
              {familyLineage[2]?.members.map((member, idx) => (
                <div id={`nG2_${idx}`} class={`pnode bg-[#121214] border border-[#1e1e22] p-3 w-[160px] md:w-[180px] flex-shrink-0 relative transition-all cursor-default mx-1 hover:border-[#2a2a2e] hover:bg-[#161618] hover:-translate-y-1 hover:shadow-[0_8px_28px_rgba(0,0,0,0.5)] hover:z-20 border-t-2 ${member.side === 'paternal' ? 'border-t-[#5a80a8]' : member.side === 'maternal' ? 'border-t-[#e0aa40]' : 'border-t-[#5a9870]'}`}>
                  <div class={`font-['DM_Mono',monospace] text-[7px] tracking-[0.08em] uppercase leading-[1.4] mb-1.5 ${member.side === 'paternal' ? 'text-[rgba(90,128,168,0.7)]' : member.side === 'maternal' ? 'text-[rgba(224,170,64,0.65)]' : 'text-[rgba(90,152,112,0.7)]'}`}>{member.role}</div>
                  <div class="font-['Playfair_Display',serif] text-[14px] md:text-[15px] font-bold text-white leading-[1.25] mb-1.5">{member.name}</div>
                  <div class="font-['DM_Mono',monospace] text-[8px] text-[#6a6260]">{member.born}</div>
                </div>
              ))}
            </div>

            <!-- G1 - Self & Siblings (2 people) -->
            <div class="gen-row flex justify-center items-start relative z-10 gap-4" id="rG1">
              {familyLineage[3]?.members.map((member, idx) => (
                <div id={`nG1_${idx}`} class={`pnode bg-[#121214] border border-[#1e1e22] p-3 w-[160px] md:w-[180px] flex-shrink-0 relative transition-all cursor-default mx-1 hover:border-[#2a2a2e] hover:bg-[#161618] hover:-translate-y-1 hover:shadow-[0_8px_28px_rgba(0,0,0,0.5)] hover:z-20 border-t-2 ${member.side === 'paternal' ? 'border-t-[#5a80a8]' : member.side === 'maternal' ? 'border-t-[#e0aa40]' : 'border-t-[#5a9870]'}`}>
                  <div class={`font-['DM_Mono',monospace] text-[7px] tracking-[0.08em] uppercase leading-[1.4] mb-1.5 ${member.side === 'paternal' ? 'text-[rgba(90,128,168,0.7)]' : member.side === 'maternal' ? 'text-[rgba(224,170,64,0.65)]' : 'text-[rgba(90,152,112,0.7)]'}`}>{member.role}</div>
                  <div class="font-['Playfair_Display',serif] text-[14px] md:text-[15px] font-bold text-white leading-[1.25] mb-1.5">{member.name}</div>
                  <div class="font-['DM_Mono',monospace] text-[8px] text-[#e0aa40]">{member.born}</div>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- List View -->
        <div id="listView" class="view-section hidden">
          {familyLineage.map((gen, genIdx) => (
            <div class="gen-section mb-10 md:mb-14 opacity-0" style={`animation: fadeIn 0.6s forwards ${0.05 + genIdx * 0.07}s`}>
              <div class="gen-head flex items-center gap-3.5 pb-3.5 border-b border-[#2a2a2e] mb-4">
                <span class="font-['Playfair_Display',serif] text-[40px] md:text-[52px] font-black text-[#2a2a2e] leading-none tracking-[-0.04em] select-none">G{4 - genIdx}</span>
                <div>
                  <span class="font-['DM_Mono',monospace] text-[10px] tracking-[0.2em] uppercase text-[#e0aa40] block">{gen.generation}</span>
                  <span class="text-[12px] md:text-[13px] text-[#6a6260] italic">{gen.subtitle}</span>
                </div>
                <div class="flex-1 h-px bg-gradient-to-r from-[#2a2a2e] to-transparent"></div>
              </div>
              
              <div class="pgrid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-2">
                {gen.members.map((member, idx) => (
                  <div class={`lcard bg-[#121214] border border-[#1e1e22] p-4 md:p-5 relative transition-all cursor-default hover:bg-[#161618] hover:border-[#2a2a2e] border-t-2 ${member.side === 'paternal' ? 'border-t-[#5a80a8]' : member.side === 'maternal' ? 'border-t-[#e0aa40]' : 'border-t-[#5a9870]'}`}>
                    <div class={`font-['DM_Mono',monospace] text-[8px] tracking-[0.13em] uppercase mb-2 leading-[1.5] ${member.side === 'paternal' ? 'text-[rgba(90,128,168,0.65)]' : member.side === 'maternal' ? 'text-[rgba(224,170,64,0.6)]' : 'text-[rgba(90,152,112,0.7)]'}`}>{member.role}</div>
                    <div class="font-['Playfair_Display',serif] text-[18px] md:text-[22px] font-bold text-white mb-3 md:mb-4 leading-[1.2] tracking-[-0.01em]">{member.name}</div>
                    <div class="flex flex-col gap-1.5">
                      <div class="flex items-baseline">
                        <span class="text-[#3a3836] w-12 flex-shrink-0 font-['DM_Mono',monospace] text-[9px] tracking-[0.06em]">Born</span>
                        <span class="flex-1 max-w-[20px] border-b border-dotted border-[#2a2a2e] mx-2 my-0"></span>
                        <span class="text-[12px] text-[#a89e92]">{member.born}</span>
                      </div>
                      <div class="flex items-baseline">
                        <span class="text-[#3a3836] w-12 flex-shrink-0 font-['DM_Mono',monospace] text-[9px] tracking-[0.06em]">Place</span>
                        <span class="flex-1 max-w-[20px] border-b border-dotted border-[#2a2a2e] mx-2 my-0"></span>
                        <span class="text-[12px] text-[#e0aa40] font-['DM_Mono',monospace] text-[10px]">{member.place}</span>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>

        <!-- Heritage Breakdown -->
        <div class="heritage bg-[#0e0e10] border border-[#2a2a2e] p-5 md:p-7 mt-8 md:mt-14">
          <div class="h-title font-['Playfair_Display',serif] text-[20px] md:text-[22px] font-bold text-white mb-1">Heritage Breakdown</div>
          <div class="h-sub text-[11px] md:text-[12px] text-[#6a6260] italic mb-4 md:mb-5.5">Paternal vs maternal lineage by known members</div>
          
          <div class="dna-bar flex h-[10px] rounded-sm overflow-hidden mb-2.5">
            <div class="dna-p bg-gradient-to-r from-[#5a80a8] to-[rgba(90,128,168,0.5)] flex-1"></div>
            <div class="dna-m bg-gradient-to-r from-[rgba(224,170,64,0.5)] to-[#e0aa40] flex-1"></div>
          </div>
          
          <div class="dna-lbls flex flex-col md:flex-row md:justify-between mb-4 md:mb-6 gap-1">
            <span class="dl font-['DM_Mono',monospace] text-[9px] tracking-[0.1em] uppercase text-[#5a80a8]">Paternal · Yadav · 50%</span>
            <span class="dl font-['DM_Mono',monospace] text-[9px] tracking-[0.1em] uppercase text-[#e0aa40]">50% · Yadav / Singh · Maternal</span>
          </div>
          
          <div class="og grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-2 md:gap-1">
            <div class="oc bg-[#0e0e10] border border-[#1e1e22] p-3 md:p-[14px] transition-all hover:bg-[#161618] hover:border-[#2a2a2e]">
              <div class="oc-lbl font-['DM_Mono',monospace] text-[8px] tracking-[0.15em] uppercase text-[#6a6260] mb-1.5">Family Origin</div>
              <div class="oc-val font-['Playfair_Display',serif] text-[16px] md:text-[17px] font-bold text-white">Azamgarh</div>
              <div class="oc-sub text-[11px] text-[#6a6260] italic mt-0.5">Uttar Pradesh, India</div>
            </div>
            <div class="oc bg-[#0e0e10] border border-[#1e1e22] p-3 md:p-[14px] transition-all hover:bg-[#161618] hover:border-[#2a2a2e]">
              <div class="oc-lbl font-['DM_Mono',monospace] text-[8px] tracking-[0.15em] uppercase text-[#6a6260] mb-1.5">Paternal Surname</div>
              <div class="oc-val font-['Playfair_Display',serif] text-[16px] md:text-[17px] font-bold text-white">Yadav</div>
              <div class="oc-sub text-[11px] text-[#6a6260] italic mt-0.5">Both paternal sides</div>
            </div>
            <div class="oc bg-[#0e0e10] border border-[#1e1e22] p-3 md:p-[14px] transition-all hover:bg-[#161618] hover:border-[#2a2a2e]">
              <div class="oc-lbl font-['DM_Mono',monospace] text-[8px] tracking-[0.15em] uppercase text-[#6a6260] mb-1.5">Maternal Surname</div>
              <div class="oc-val font-['Playfair_Display',serif] text-[16px] md:text-[17px] font-bold text-white">Singh / Yadav</div>
              <div class="oc-sub text-[11px] text-[#6a6260] italic mt-0.5">Ram Awadh Singh lineage</div>
            </div>
            <div class="oc bg-[#0e0e10] border border-[#1e1e22] p-3 md:p-[14px] transition-all hover:bg-[#161618] hover:border-[#2a2a2e]">
              <div class="oc-lbl font-['DM_Mono',monospace] text-[8px] tracking-[0.15em] uppercase text-[#6a6260] mb-1.5">Known Members</div>
              <div class="oc-val font-['Playfair_Display',serif] text-[16px] md:text-[17px] font-bold text-white">14</div>
              <div class="oc-sub text-[11px] text-[#6a6260] italic mt-0.5">across 4 generations</div>
            </div>
            <div class="oc bg-[#0e0e10] border border-[#1e1e22] p-3 md:p-[14px] transition-all hover:bg-[#161618] hover:border-[#2a2a2e]">
              <div class="oc-lbl font-['DM_Mono',monospace] text-[8px] tracking-[0.15em] uppercase text-[#6a6260] mb-1.5">Generations Mapped</div>
              <div class="oc-val font-['Playfair_Display',serif] text-[16px] md:text-[17px] font-bold text-white">4</div>
              <div class="oc-sub text-[11px] text-[#6a6260] italic mt-0.5">G4 → G1 · complete</div>
            </div>
            <div class="oc bg-[#0e0e10] border border-[#1e1e22] p-3 md:p-[14px] transition-all hover:bg-[#161618] hover:border-[#2a2a2e]">
              <div class="oc-lbl font-['DM_Mono',monospace] text-[8px] tracking-[0.15em] uppercase text-[#6a6260] mb-1.5">Unknown Members</div>
              <div class="oc-val font-['Playfair_Display',serif] text-[16px] md:text-[17px] font-bold text-white">7</div>
              <div class="oc-sub text-[11px] text-[#6a6260] italic mt-0.5">to be discovered</div>
            </div>
          </div>
        </div>

        <!-- Footer -->
        <footer class="mt-12 md:mt-20 pt-6 border-t border-[#2a2a2e] font-['DM_Mono',monospace] text-[10px] tracking-[0.1em] text-[#6a6260] flex flex-col md:flex-row justify-between gap-2">
          <a href="/" class="hover:text-[#a89e92] transition-colors">← back to home</a>
          <span>~/family-tree · 4 generations · Azamgarh, UP</span>
        </footer>
      </div>
    </div>

    <style>
      @keyframes fadeIn {
        from { opacity: 0; transform: translateY(16px); }
        to { opacity: 1; transform: translateY(0); }
      }
      
      @keyframes draw {
        to { stroke-dashoffset: 0; }
      }
      
      .view-btn.active {
        border-color: #e0aa40;
        color: #e0aa40;
        background: rgba(224, 170, 64, 0.06);
      }
      
      .tree-canvas {
        min-height: 700px;
      }
      
      .gen-row {
        margin-bottom: 48px;
      }
      
      @media (min-width: 768px) {
        .gen-row {
          margin-bottom: 80px;
        }
      }
    </style>

    <script>
      // View toggle
      document.querySelectorAll('.view-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const view = btn.dataset.view;
          
          document.querySelectorAll('.view-btn').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          
          if (view === 'tree') {
            document.getElementById('treeView').classList.remove('hidden');
            document.getElementById('listView').classList.add('hidden');
            setTimeout(drawConnections, 100);
          } else {
            document.getElementById('treeView').classList.add('hidden');
            document.getElementById('listView').classList.remove('hidden');
          }
        });
      });

      // Draw SVG connections for tree view
      function drawConnections() {
        const canvas = document.getElementById('canvas');
        const svg = document.getElementById('svg');
        if (!canvas || !svg) return;
        
        svg.innerHTML = '';
        const height = canvas.scrollHeight;
        const width = canvas.scrollWidth;
        svg.setAttribute('viewBox', `0 0 ${width} ${height}`);
        svg.style.width = width + 'px';
        svg.style.height = height + 'px';

        const paternalColor = '#5a80a8';
        const maternalColor = '#e0aa40';

        function getMidpoint(element, canvasEl) {
          if (!element) return null;
          const er = element.getBoundingClientRect();
          const cr = canvasEl.getBoundingClientRect();
          return {
            x: er.left - cr.left + er.width / 2,
            top: er.top - cr.top,
            bot: er.bottom - cr.top
          };
        }

        function drawCurve(x1, y1, x2, y2, color, delay = 0) {
          const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
          const cy = (y1 + y2) / 2;
          path.setAttribute('d', `M${x1},${y1} C${x1},${cy} ${x2},${cy} ${x2},${y2}`);
          path.setAttribute('stroke', color);
          path.setAttribute('stroke-width', '1.5');
          path.setAttribute('fill', 'none');
          path.setAttribute('opacity', '0.45');
          path.setAttribute('stroke-dasharray', '500');
          path.setAttribute('stroke-dashoffset', '500');
          path.style.animation = `draw 1s ease ${delay}s forwards`;
          svg.appendChild(path);
        }

        function drawHBar(x1, x2, y, color) {
          const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
          line.setAttribute('x1', x1);
          line.setAttribute('y1', y);
          line.setAttribute('x2', x2);
          line.setAttribute('y2', y);
          line.setAttribute('stroke', color);
          line.setAttribute('stroke-width', '1');
          line.setAttribute('opacity', '0.28');
          svg.appendChild(line);
        }

        const g4Nodes = canvas.querySelectorAll('#rG4 .pnode');
        const g3Nodes = canvas.querySelectorAll('#rG3 .pnode');
        const g2Nodes = canvas.querySelectorAll('#rG2 .pnode');
        const g1Nodes = canvas.querySelectorAll('#rG1 .pnode');
        
        let delay = 0;
        
        // ===== G4 TO G3 CONNECTIONS =====
        
        // 1. Paternal Grandfather's parents (G4[0], G4[1]) → Paternal Grandfather (G3[0])
        if (g4Nodes.length >= 2 && g3Nodes.length >= 1) {
          const m1 = getMidpoint(g4Nodes[0], canvas);
          const m2 = getMidpoint(g4Nodes[1], canvas);
          const m3 = getMidpoint(g3Nodes[0], canvas);
          if (m1 && m2 && m3) {
            const midX = (m1.x + m2.x) / 2;
            drawHBar(m1.x, m2.x, m1.bot + 10, paternalColor);
            drawCurve(midX, m1.bot + 10, m3.x, m3.top - 5, paternalColor, delay++);
          }
        }
        
        // 2. Paternal Grandmother's parents (G4[2], G4[3]) → Paternal Grandmother (G3[1]) - DALAPATI YADAV
        if (g4Nodes.length >= 4 && g3Nodes.length >= 2) {
          const m1 = getMidpoint(g4Nodes[2], canvas);
          const m2 = getMidpoint(g4Nodes[3], canvas);
          const m3 = getMidpoint(g3Nodes[1], canvas);
          if (m1 && m2 && m3) {
            const midX = (m1.x + m2.x) / 2;
            drawHBar(m1.x, m2.x, m1.bot + 10, paternalColor);
            drawCurve(midX, m1.bot + 10, m3.x, m3.top - 5, paternalColor, delay++);
          }
        }
        
        // 3. Maternal Grandfather's parents (G4[4], G4[5]) → Maternal Grandfather (G3[2])
        if (g4Nodes.length >= 6 && g3Nodes.length >= 3) {
          const m1 = getMidpoint(g4Nodes[4], canvas);
          const m2 = getMidpoint(g4Nodes[5], canvas);
          const m3 = getMidpoint(g3Nodes[2], canvas);
          if (m1 && m2 && m3) {
            const midX = (m1.x + m2.x) / 2;
            drawHBar(m1.x, m2.x, m1.bot + 10, maternalColor);
            drawCurve(midX, m1.bot + 10, m3.x, m3.top - 5, maternalColor, delay++);
          }
        }
        
        // 4. Maternal Grandmother's parents (G4[6], G4[7]) → Maternal Grandmother (G3[3]) - SUBHAWATI SINGH
        if (g4Nodes.length >= 8 && g3Nodes.length >= 4) {
          const m1 = getMidpoint(g4Nodes[6], canvas);
          const m2 = getMidpoint(g4Nodes[7], canvas);
          const m3 = getMidpoint(g3Nodes[3], canvas);
          if (m1 && m2 && m3) {
            const midX = (m1.x + m2.x) / 2;
            drawHBar(m1.x, m2.x, m1.bot + 10, maternalColor);
            drawCurve(midX, m1.bot + 10, m3.x, m3.top - 5, maternalColor, delay++);
          }
        }
        
        // ===== G3 TO G2 CONNECTIONS =====
        
        // 5. Paternal Grandfather (G3[0]) → Father (G2[0])
        if (g3Nodes.length >= 1 && g2Nodes.length >= 1) {
          const m3 = getMidpoint(g3Nodes[0], canvas);
          const m2 = getMidpoint(g2Nodes[0], canvas);
          if (m3 && m2) {
            drawCurve(m3.x, m3.bot, m2.x, m2.top - 5, paternalColor, delay++);
          }
        }
        
        // 6. Paternal Grandmother (G3[1]) → Father (G2[0]) - DALAPATI YADAV CONNECTION
        if (g3Nodes.length >= 2 && g2Nodes.length >= 1) {
          const m3 = getMidpoint(g3Nodes[1], canvas);
          const m2 = getMidpoint(g2Nodes[0], canvas);
          if (m3 && m2) {
            drawCurve(m3.x, m3.bot, m2.x, m2.top - 5, paternalColor, delay++);
          }
        }
        
        // 7. Maternal Grandfather (G3[2]) → Mother (G2[1])
        if (g3Nodes.length >= 3 && g2Nodes.length >= 2) {
          const m3 = getMidpoint(g3Nodes[2], canvas);
          const m2 = getMidpoint(g2Nodes[1], canvas);
          if (m3 && m2) {
            drawCurve(m3.x, m3.bot, m2.x, m2.top - 5, maternalColor, delay++);
          }
        }
        
        // 8. Maternal Grandmother (G3[3]) → Mother (G2[1]) - SUBHAWATI SINGH CONNECTION
        if (g3Nodes.length >= 4 && g2Nodes.length >= 2) {
          const m3 = getMidpoint(g3Nodes[3], canvas);
          const m2 = getMidpoint(g2Nodes[1], canvas);
          if (m3 && m2) {
            drawCurve(m3.x, m3.bot, m2.x, m2.top - 5, maternalColor, delay++);
          }
        }
        
        // ===== G2 TO G1 CONNECTIONS =====
        
        // 9 & 10. Parents (G2[0], G2[1]) → Self (G1[0]) and Brother (G1[1]) - ARYAN YADAV CONNECTION
        if (g2Nodes.length >= 2 && g1Nodes.length >= 2) {
          const mf = getMidpoint(g2Nodes[0], canvas);
          const mm = getMidpoint(g2Nodes[1], canvas);
          const ms = getMidpoint(g1Nodes[0], canvas);
          const br = getMidpoint(g1Nodes[1], canvas);
          
          if (mf && mm && ms && br) {
            const midX = (mf.x + mm.x) / 2;
            const hBarY = mf.bot + 10;
            
            // Draw horizontal bar between parents
            drawHBar(mf.x, mm.x, hBarY, '#9a9070');
            
            // Draw vertical line down from center of hBar
            const vLineBottom = Math.min(ms.top, br.top) - 5;
            const vLine = document.createElementNS('http://www.w3.org/2000/svg', 'line');
            vLine.setAttribute('x1', midX);
            vLine.setAttribute('y1', hBarY);
            vLine.setAttribute('x2', midX);
            vLine.setAttribute('y2', vLineBottom);
            vLine.setAttribute('stroke', '#9a9070');
            vLine.setAttribute('stroke-width', '1.5');
            vLine.setAttribute('opacity', '0.45');
            vLine.style.animation = `draw 1s ease ${delay}s forwards`;
            svg.appendChild(vLine);
            delay += 0.1;
            
            // Draw curve to Self
            drawCurve(midX, vLineBottom, ms.x, ms.top - 5, '#9a9070', delay++);
            
            // Draw curve to Brother
            drawCurve(midX, vLineBottom, br.x, br.top - 5, '#9a9070', delay++);
          }
        } else if (g2Nodes.length >= 2 && g1Nodes.length >= 1) {
           // Fallback if only 1 child exists
           const mf = getMidpoint(g2Nodes[0], canvas);
           const mm = getMidpoint(g2Nodes[1], canvas);
           const ms = getMidpoint(g1Nodes[0], canvas);
           if (mf && mm && ms) {
             const midX = (mf.x + mm.x) / 2;
             drawHBar(mf.x, mm.x, mf.bot + 10, '#9a9070');
             drawCurve(midX, mf.bot + 10, ms.x, ms.top - 5, '#9a9070', delay++);
           }
        }
        
        window.addEventListener('resize', () => {
          if (!document.getElementById('treeView').classList.contains('hidden')) {
            setTimeout(drawConnections, 100);
          }
        });
      }

      // Initial draw
      setTimeout(drawConnections, 250);
    </script>
  </>
</BaseLayout>